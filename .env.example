# ---------------------------------------------------------------------------
# Public values. These are COMPILED INTO THE MOBILE BUNDLE.
# Never put a private key here — treat every value below as world-readable.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
EXPO_PUBLIC_CLERK_GOOGLE_IOS_URL_SCHEME=
EXPO_PUBLIC_CONVEX_URL=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_ANALYTICS_KEY=
EXPO_PUBLIC_ANALYTICS_HOST=

# Published legal documents. Required for release builds: Apple needs a reachable
# privacy policy and EULA from the subscription screen, Play needs a privacy
# policy URL. A production build throws at startup when either is missing.
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=

# ---------------------------------------------------------------------------
# Server values. Set with `npx convex env set NAME value`.
# Do NOT place these in a local .env that Expo loads, and never commit them.
# ---------------------------------------------------------------------------
# CLERK_ISSUER_URL=          # Clerk JWT issuer, read by convex/auth.config.ts
# CLERK_SECRET_KEY=          # Clerk Backend API key, used to delete accounts
# REVENUECAT_SECRET_KEY=     # RevenueCat REST v1 key for entitlement verification
# REVENUECAT_WEBHOOK_SECRET= # Shared bearer token on /revenuecat/webhook
#                            # (`/revenuecat-webhook` is also accepted for compatibility.)
# AI_API_KEY=                # OpenAI key used by ai.ts and planGeneration.ts.
#                            # `OPENAI_API_KEY` is accepted as an alias.
#                            # Deployed actions read the CONVEX DEPLOYMENT's
#                            # environment, never this file:
#                            #   npx convex env set AI_API_KEY sk-...
# AI_MODEL=gpt-5.4-mini      # Optional model override
# AI_PROVIDER=openai         # Only "openai" is implemented

# ---------------------------------------------------------------------------
# Build/release tooling. Set in EAS secrets, not here.
# ---------------------------------------------------------------------------
# EXPO_ACCESS_TOKEN=
# SENTRY_AUTH_TOKEN=      # Org auth token; only needed when uploading artifacts
# SENTRY_ORG=             # Sentry org slug, required by the Xcode upload phase
# SENTRY_PROJECT=         # Sentry project slug

# The @sentry/react-native Xcode build phase tries to upload source maps on
# every `expo run:ios` build and fails the build (xcodebuild error 65) when no
# org/token is configured. Keep this set for local development; release builds
# supply SENTRY_ORG/SENTRY_PROJECT/SENTRY_AUTH_TOKEN via EAS secrets instead.
SENTRY_DISABLE_AUTO_UPLOAD=true
