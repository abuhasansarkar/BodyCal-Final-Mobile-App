# ---------------------------------------------------------------------------
# Public values. These are COMPILED INTO THE MOBILE BUNDLE.
# Never put a private key here — treat every value below as world-readable.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
EXPO_PUBLIC_CLERK_GOOGLE_IOS_URL_SCHEME=
EXPO_PUBLIC_CONVEX_URL=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_ANALYTICS_KEY=
EXPO_PUBLIC_ANALYTICS_HOST=

# ---------------------------------------------------------------------------
# Server values. Set with `npx convex env set NAME value`.
# Do NOT place these in a local .env that Expo loads, and never commit them.
# ---------------------------------------------------------------------------
# CLERK_ISSUER_URL=          # Clerk JWT issuer, read by convex/auth.config.ts
# CLERK_SECRET_KEY=          # Clerk Backend API key, used to delete accounts
# REVENUECAT_SECRET_KEY=     # RevenueCat REST v1 key for entitlement verification
# REVENUECAT_WEBHOOK_SECRET= # Shared bearer token on /revenuecat/webhook
# AI_API_KEY=                # OpenAI key used by ai.ts and planGeneration.ts
# AI_MODEL=gpt-4o-mini       # Optional model override

# ---------------------------------------------------------------------------
# Build/release tooling. Set in EAS secrets, not here.
# ---------------------------------------------------------------------------
# EXPO_ACCESS_TOKEN=
# SENTRY_AUTH_TOKEN=
