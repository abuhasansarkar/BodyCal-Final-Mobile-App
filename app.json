{
  "expo": {
    "name": "BodyCal",
    "slug": "BodyCal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bodycal",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.bodycal.app",
      "icon": "./assets/expo.icon",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "BodyCal uses your camera to estimate nutrition from a meal photo.",
        "NSPhotoLibraryUsageDescription": "BodyCal lets you choose a meal photo for nutrition estimation."
      }
    },
    "android": {
      "package": "com.bodycal.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@clerk/expo",
      "@clerk/expo-google-signin",
      "expo-localization",
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow BodyCal to photograph meals for nutrition estimates.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow BodyCal to choose meal photos for nutrition estimates."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#208AEF"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/BodyCal-Black-Logo.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
